{
  "name": "kite",
  "productName": "Kite",
  "version": "1.0.0",
  "description": "A voice companion beside your cursor. Hold, ask, or circle anything on screen.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./tests/register.cjs --test tests/physics.test.cjs tests/voice.test.cjs tests/providers-tts.test.cjs tests/tools.test.cjs tests/vision.test.cjs tests/guide.test.cjs tests/board.test.cjs tests/board-script.test.cjs tests/board-teaching.test.cjs tests/board-metrics.test.cjs tests/agent.test.cjs tests/windows.test.cjs tests/shop.test.cjs tests/job.test.cjs tests/permissions.test.cjs tests/memory.test.cjs tests/checkout.test.cjs tests/repeat.test.cjs",
    "test:capture": "electron tests/capture-native.cjs",
    "test:native": "electron tests/native-smoke.cjs",
    "test:clipboard": "electron tests/clipboard-native.cjs",
    "test:notepad": "electron tests/notepad-focus.cjs",
    "test:renderer": "electron tests/renderer-smoke.cjs",
    "test:startup": "electron tests/startup-smoke.cjs",
    "test:uia": "electron tests/uia-native.cjs",
    "test:agent": "electron tests/agent-native.cjs",
    "test:unit": "vitest run",
    "test:packaged": "node scripts/smoke.cjs",
    "assets": "python scripts/brand.py",
    "perf": "electron scripts/perf.cjs",
    "eval:routing": "node scripts/routing-eval.cjs",
    "eval:board": "node scripts/board-eval.cjs",
    "eval:board:gallery": "electron scripts/board-gallery.cjs",
    "eval:board:phase1": "node scripts/board-phase1.cjs",
    "eval:board:live": "electron scripts/board-live.cjs",
    "measure:web": "node tests/web-measure.cjs",
    "test:job": "node tests/job-live.cjs",
    "shop": "node tests/fixtures/shop/server.cjs",
    "eval:board:phase2": "node scripts/board-phase2.cjs",
    "assets:board-icons": "electron scripts/board-icons.cjs",
    "eval:board:layout": "node scripts/board-phase2-bench.cjs",
    "eval:board:phase2:replay": "node scripts/board-phase2-replay.cjs",
    "eval:board:phase3": "node scripts/board-phase3.cjs",
    "eval:board:phase3:providers": "node scripts/board-phase2.cjs --phase3 --formats json --out phase3-provider-probe.json",
    "eval:board:phase3:live": "electron scripts/board-teaching-live.cjs"
  },
  "keywords": [
    "electron",
    "voice-assistant",
    "byok",
    "desktop-companion",
    "vision"
  ],
  "author": {
    "name": "Dheeraj-Manwani",
    "email": "dkmanwani2000@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@tabler/icons": "^3.49.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.4.5",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/google": "^4.0.82",
    "@ai-sdk/groq": "^4.0.50",
    "@ai-sdk/openai": "^4.0.78",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@cartesia/cartesia-js": "^4.2.0",
    "@mathjax/src": "^4.1.3",
    "ai": "^7.0.118",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "elkjs": "^0.12.0",
    "fuse.js": "^7.5.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uiohook-napi": "^1.5.5",
    "update-electron-app": "^3.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Dheeraj-Manwani/kite.git"
  },
  "homepage": "https://github.com/Dheeraj-Manwani/kite"
}
